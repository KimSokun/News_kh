# ==============================================================================
# Telegram Bot Configuration (Required)
# ==============================================================================
# Get BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Parse mode: HTML (recommended) or Markdown
TELEGRAM_PARSE_MODE=HTML

# ==============================================================================
# Telegram Channel Configuration (Optional / Recommended for Channels)
# ==============================================================================
# Telegram Channel ID or Username (e.g. @YourChannelUsername or -1001234567890)
# Multiple channels can be separated by comma: @channel1,@channel2,-1001234567890
# NOTE: The bot MUST be added to the channel as an Administrator with "Post Messages" permission!
TELEGRAM_CHANNEL_IDS=

# Broadcast destinations
BROADCAST_TO_CHANNEL=true
BROADCAST_TO_SUBSCRIBERS=true

# Add inline buttons (e.g. "🔗 Read More / អានដើម") to channel cards
CHANNEL_ENABLE_BUTTONS=true

# ==============================================================================
# Auto-Moderation / Anti-Spam (For Channel Comments & Discussion Groups)
# ==============================================================================
# Master switch for moderation
ENABLE_MODERATION=true
# Automatically delete messages containing links / URLs from non-admins
AUTO_DELETE_LINKS=true
# Automatically delete documents, files, and APKs from non-admins
AUTO_DELETE_FILES=true
# Automatically ban spammers who send links/files (false = only delete message)
AUTO_BAN_SPAMMERS=false

# ==============================================================================
# AI & External API Keys (Optional with Auto-Fallback)
# ==============================================================================
# Gemini AI API Key (for Khmer AI summarization & Big News evaluation)
GEMINI_API_KEY=
# Gemini Model: gemini-3.6-flash, gemini-flash-latest, gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.6-flash


# NewsAPI Key (If blank or exhausted, bot automatically uses trusted RSS feeds)
NEWS_API_KEY=

# ==============================================================================
# Polling & Category Settings
# ==============================================================================
# Background News Polling Interval in seconds (300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# Categories to monitor (Technology Focus)
ALERT_CATEGORIES=tech

# Language & Photo Options
TRANSLATE_TO_KHMER=true
SEND_PHOTO=true

# ==============================================================================
# Smart News Filters & Rate Limiting
# ==============================================================================
# If true, strictly sends ONLY news that has a valid image / photo card
REQUIRE_PHOTO_CARD=true

# If true, filters and sends ONLY MAJOR / BREAKING / HIGH-IMPACT news (set false to receive all technology news)
ONLY_BIG_NEWS=false

# Maximum alerts sent per check cycle across ALL categories combined (prevents spamming)
MAX_ALERTS_PER_CYCLE=2
MAX_ITEMS_PER_CHECK=50

# Seed existing news on first run to prevent sending older baseline news
SEED_ON_FIRST_RUN=true

# Network Timeout in seconds
HTTP_TIMEOUT=15

